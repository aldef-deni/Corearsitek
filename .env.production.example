# ================================================================
# CoreArsitek — konfigurasi PRODUKSI (corearsitek.aldeftech.com)
#
# Cara pakai di server:
#   cp .env.production.example .env
#   nano .env                 # isi kredensial yang masih kosong
#   php artisan key:generate  # mengisi APP_KEY otomatis
#
# Baris yang perlu DIISI SENDIRI ditandai dengan  <-- ISI
# ================================================================

APP_NAME=CoreArsitek
APP_ENV=production
APP_KEY=                                  # <-- ISI (jalankan: php artisan key:generate)
APP_DEBUG=false
APP_URL=https://corearsitek.aldeftech.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------- Database ----------------
# Pilih salah satu.
#
# A. MySQL / MariaDB (disarankan untuk produksi)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=corearsitek
DB_USERNAME=                              # <-- ISI
DB_PASSWORD=                              # <-- ISI
#
# B. SQLite (paling ringan, tanpa server database)
#    Hapus blok MySQL di atas, lalu pakai dua baris ini:
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/corearsitek/database/database.sqlite

# ---------------- Session & cache ----------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=corearsitek.aldeftech.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------- Redis (opsional) ----------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------- Email ----------------
# Dipakai kalau nanti ada notifikasi / reset password.
MAIL_MAILER=smtp
MAIL_HOST=                                # <-- ISI (mis. smtp.gmail.com)
MAIL_PORT=587
MAIL_USERNAME=                            # <-- ISI
MAIL_PASSWORD=                            # <-- ISI
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=                        # <-- ISI (mis. info@corearsitek.com)
MAIL_FROM_NAME="${APP_NAME}"

# ---------------- Lain-lain ----------------
VITE_APP_NAME="${APP_NAME}"
